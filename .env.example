# ==============================================================================
# VANA Platform — Environment Configuration Template (VM / Production & Local)
# ==============================================================================
# Usage on VM (DevOps):
#   cp .env.example .env
#   # Fill in all CHANGE_ME values, then deploy.
#
# NEVER commit the real .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime Environment
#    "production" enforces strong non-default credentials and strict CORS.
#    "development" allows local SQLite fallbacks and dev defaults.
# ------------------------------------------------------------------------------
VANA_ENV=production

# ------------------------------------------------------------------------------
# 2. PostgreSQL / PostGIS Database (Shared by MasterDB & Unified Auth)
#    IMPORTANT: If POSTGRES_PASSWORD contains special URL characters (@ # % :),
#    URL-encode them in both POSTGRES_PASSWORD and VANA_DATABASE_URL:
#      @ -> %40 | # -> %23 | % -> %25 | : -> %3A
# ------------------------------------------------------------------------------
POSTGRES_USER=vana
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password
POSTGRES_DB=vana_masterdb

# Used by MasterDB (Group 1) and Unified Auth (Group 4) services.
# Inside Docker Compose, host is "vana-db". On bare-metal VM, use "127.0.0.1" or DB host IP.
VANA_DATABASE_URL=postgresql://vana:CHANGE_ME_strong_postgres_password@vana-db:5432/vana_masterdb

# ------------------------------------------------------------------------------
# 3. Exposed Host Ports (VM)
# ------------------------------------------------------------------------------
VANA_FRONTEND_PORT=8080
VANA_G1_PORT=8013
VANA_AUTH_PORT=8010

# ------------------------------------------------------------------------------
# 4. Reverse Proxy Upstream Targets (Used by Frontend Nginx / Local server.py)
#    Docker Compose defaults point to internal container service names.
#    For bare-metal VM without Docker, set these to http://127.0.0.1:<port>.
# ------------------------------------------------------------------------------
VANA_G1_URL=http://vana-masterdb:8000
VANA_BACKEND_URL=http://vana-auth:8000
VANA_G4_URL=http://vana-auth:8000
VANA_G2_URL=https://niyantran.blackholeinfiverse.com

# Optional: Group 2 / Group 4 Node.js runtime targets (only if deploying Node services)
SANSKAR_SERVICE_URL=http://vana-auth:8000
GROUP1_SERVICE_URL=http://vana-masterdb:8000
NEXT_PUBLIC_VANA_GROUP2_URL=https://niyantran.blackholeinfiverse.com/api/group2/context/resolve
NEXT_PUBLIC_VANA_GROUP4_URL=http://vana-auth:8000

# ------------------------------------------------------------------------------
# 5. CORS Allowed Origins (comma-separated, no trailing slashes)
#    Set to your public VM domain(s), e.g.:
#      VANA_CORS_ORIGINS=https://vana.maharashtra.gov.in
# ------------------------------------------------------------------------------
VANA_CORS_ORIGINS=https://vana.example.com

# ------------------------------------------------------------------------------
# 6. Predefined RBAC Accounts (Seeded idempotently with bcrypt on first boot)
#    REQUIRED in production: startup fails if passwords are left as defaults.
# ------------------------------------------------------------------------------
VANA_ADMIN_EMAIL=admin@vana.gov.in
VANA_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

VANA_FIELD_EMAIL=field@vana.gov.in
VANA_FIELD_PASSWORD=CHANGE_ME_strong_field_password

VANA_FOREST_EMAIL=forest@vana.gov.in
VANA_FOREST_PASSWORD=CHANGE_ME_strong_forest_password

VANA_DWELLER_EMAIL=dweller@vana.gov.in
VANA_DWELLER_PASSWORD=CHANGE_ME_strong_dweller_password

# Session validity duration in seconds (default: 86400 = 24 hours)
VANA_SESSION_TTL_SECONDS=86400